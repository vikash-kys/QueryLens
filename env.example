# Copy this to .env and fill in your API key
# ─────────────────────────────────────────────

# LLM Provider: "anthropic" (default), "openai", or "gemini"
LLM_PROVIDER=gemini

# Google Gemini (default model: gemini-3.8-flash)
GEMINI_API_KEY=your_gemini_api_key

# Anthropic (default model: claude-sonnet-5-5) — only needed if LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (default model: gpt-6-astra) — only needed if LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Override the model for any provider (optional)
# LLM_MODEL_GEMINI=gemini-3.8-flash

# Guardrail settings (optional overrides)
MAX_ROWS=1000
QUERY_TIMEOUT_SECONDS=30
