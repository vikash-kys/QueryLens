# Local development: Docker PostgreSQL is mapped to loopback port 5433.
DATABASE_URL=postgresql+psycopg://readonly:readonly@127.0.0.1:5433/analytics

# AI is optional for SQL mode. Supply a provider-supported model ID and key.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=ENTER_YOUR_GEMINI_API_KEY
LLM_MODEL_ANTHROPIC=
LLM_MODEL_OPENAI=
LLM_MODEL_GEMINI=
GEMINI_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=4096
# Set false for one generation call per question; skips AI reviews and confidence scoring.
ENABLE_AI_REVIEW=true

MAX_ROWS=1000
MAX_SUBQUERY_DEPTH=3
QUERY_TIMEOUT_SECONDS=30
MIN_CONFIDENCE_TO_EXECUTE=0.3
HALLUCINATION_FLAG_THRESHOLD=0.5
HISTORY_LIMIT=100
ENABLE_LIVE_EVALS=false
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
